# systemd unit that keeps the cheapest hours API running on the VM (api/main.py, guide: docs/api.md).
#
# It runs from the same clone and Python environment as the dashboard (~/dat535-dashboard, ~/dashboard-env;
# see deploy/dat535-dashboard.service), after:
#   cd ~/dat535-dashboard && git pull
#   source ~/dashboard-env/bin/activate && pip install -r requirements-dashboard.txt
#
# Install and start:
#   sudo cp deploy/dat535-api.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now dat535-api
#   journalctl -u dat535-api -f              # logs
#
# Use it from your laptop through an SSH tunnel (nothing is exposed publicly):
#   ssh -L 8000:localhost:8000 ubuntu@<vm floating ip>     then http://localhost:8000/
# The API is open (no key). Its documentation for people is the dashboard's "API for apps" page.

[Unit]
Description=DAT535 cheapest hours API (Gold layer, use case 1)
After=network.target

[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu/dat535-dashboard
Environment=DAT535_ENV=prod
Environment=DAT535_DATA_DIR=/home/ubuntu/spark-project-data
ExecStart=/home/ubuntu/dashboard-env/bin/uvicorn api.main:app --host 127.0.0.1 --port 8000 --workers 1
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
