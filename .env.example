# ==========================================
# DAT535 Project Environment Configuration
# ==========================================

# MET Norway Frost API Credentials
# Obtain free instant credentials at: https://frost.met.no/auth/requestCredentials.html
FROST_CLIENT_ID=your_client_id_here
FROST_CLIENT_SECRET=your_client_secret_here

# Deployment environment: dev (default) or prod.
# Only the GitHub Actions workflows on main use prod; keep dev for local and manual runs.
DAT535_ENV=dev

# Data root for Medallion Storage (Bronze -> Silver -> Gold).
# The environment is appended: data lands in <DAT535_DATA_DIR>/<DAT535_ENV>/bronze, ...
# VM Runner default: /home/ubuntu/spark-project-data
# Local default: ./data
DAT535_DATA_DIR=./data
